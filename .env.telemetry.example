# Credentials for the telemetry-lab Postgres — the one the dwh-dbt warehouse reads.
# Used by docker-compose.telemetry.yml and by `python -m src.telemetry_lab.cli load`.
WAREHOUSE_DB=saas_dw
WAREHOUSE_USER=saas
WAREHOUSE_PASSWORD=saas
WAREHOUSE_PORT=5434

# Overrides for when the generator has to reach a different server.
# POSTGRES_HOST=localhost
